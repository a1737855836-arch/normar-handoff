      "id": "process-honey-colors",
      "name": "蜜处理颜色档",
      "nameEn": "Honey Color Grades (White/Yellow/Red/Black)",
      "labelIds": [
        "bean-process"
      ],
      "labelNames": [
        "Process发酵处理"
      ],
      "ingredients": [
        {
          "item": "白/黄蜜 White/Yellow",
          "amount": "",
          "note": "果胶较少，更靠近水洗的干净。"
        },
        {
          "item": "红/黑蜜 Red/Black",
          "amount": "",
          "note": "果胶较多，更甜、更重，有时偏酒感。"
        },
        {
          "item": "口径",
          "amount": "",
          "note": "行业常用提示，命名未全球统一；勿当法定色标。"
        }
      ],
      "method": [
        "理解：颜色大致对应干燥时残留 mucilage 多寡。",
        "检查：同一产区不同庄园的「红蜜」可能不对齐；以杯测为准。"
      ],
      "notes": "COFFEE-004 P03a/P03b；短卡提示性。",
      "source": "Royal Coffee · Honey colors · Sustainable Harvest",
      "sourceUrls": [
        "https://royalcoffee.com/coffee-processing-styles-and-terminology-plus-flowchart/",
        "https://www.sustainableharvest.com/blog/understanding-coffee-processing-the-traditional-methods"
      ]
    },
