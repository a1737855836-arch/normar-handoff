      "id": "process-washed",
      "name": "水洗",
      "nameEn": "Washed",
      "labelIds": [
        "bean-process"
      ],
      "labelNames": [
        "Process发酵处理"
      ],
      "ingredients": [
        {
          "item": "定义",
          "amount": "",
          "note": "去皮后发酵软化果胶，再冲洗、干燥；豆面只留羊皮纸进入干燥。"
        },
        {
          "item": "杯感",
          "amount": "",
          "note": "偏干净、酸质清晰，常突出产地与品种本身。"
        },
        {
          "item": "检查要点",
          "amount": "",
          "note": "包装若写 Fully Washed / Wet Process，通常指有冲洗槽分选密度的线路。"
        }
      ],
      "method": [
        "理解：果肉去掉后靠发酵溶解 mucilage，再用水洗掉，干燥时不带整果。",
        "对照杯感：干净度、酸清晰度是否高于同产区日晒。",
        "勿与「半水洗/蜜处理」混读：蜜处理去皮后通常不经完整水洗槽。"
      ],
      "notes": "COFFEE-004 P01；首版必上。",
      "source": "NCA About Coffee · Processes",
      "sourceUrls": [
        "https://www.aboutcoffee.org/beans/processes/"
      ]
    },
    {
      "cardType": "knowledge",
      "reproducibleRecipe": false,
      "glass": null,
      "beanNote": null,
      "tips": null,
      "story": null,
      "credibility": "协会 + 烘焙商科普",
      "id": "process-natural",
      "name": "日晒（干法）",
      "nameEn": "Natural / Dry Process",
      "labelIds": [
        "bean-process"
      ],
      "labelNames": [
        "Process发酵处理"
      ],
      "ingredients": [
        {
          "item": "定义",
          "amount": "",
          "note": "整颗樱桃带果肉干燥后再脱壳；英语亦称 dry-process / cherry-dried。"
        },
        {
          "item": "杯感",
          "amount": "",
          "note": "偏甜、果香、酒感更重；干燥管理差则易过酵或瑕疵。"
        },
        {
          "item": "风险",
          "amount": "",
          "note": "熟度不齐的樱桃混晒会放大批次不一致。"
        }
      ],
      "method": [
        "理解：整果干燥至约 11% 含水再脱壳，非「未处理」。",
        "检查：日晒≠一定更甜；看干燥场地、翻耙与挑熟。",
        "与季风区分：季风是日晒樱桃豆之后的海岸高湿仓暴露。"
      ],
      "notes": "COFFEE-004 P02。",
      "source": "NCA Processes · Peet's processing overview",
      "sourceUrls": [
        "https://www.aboutcoffee.org/beans/processes/",
        "https://www.peets.com/blogs/peets/washed-natural-wet-hulled-coffee-processing"
      ]
    },
    {
      "cardType": "knowledge",
      "reproducibleRecipe": false,
      "glass": null,
      "beanNote": null,
      "tips": null,
      "story": null,
      "credibility": "协会 + 生豆商",
      "id": "process-honey",
      "name": "蜜处理",
      "nameEn": "Honey Process",
      "labelIds": [
        "bean-process"
      ],
      "labelNames": [
        "Process发酵处理"
      ],
      "ingredients": [
        {
          "item": "定义",
          "amount": "",
          "note": "去皮后保留部分果胶（mucilage）干燥；「蜜」指粘性果胶质地，并非加蜂蜜。"
        },
        {
          "item": "杯感",
          "amount": "",
          "note": "保留果胶越多通常越甜、越接近日晒；少则更靠近水洗干净。"
        },
        {
          "item": "近义词",
          "amount": "",
          "note": "英语里常与 pulped natural / semi-washed 近义互换（见独立卡）。"
        }
      ],
      "method": [
        "理解：半干法族——去皮、不（或少）走完整水洗槽。",
        "检查：看卖家是否标明留胶量/颜色档；勿写死全球标准。"
      ],
      "notes": "COFFEE-004 P03。",
      "source": "NCA · Semi-Washed or Honey · Sustainable Harvest",
      "sourceUrls": [
        "https://www.aboutcoffee.org/beans/processes/",
        "https://www.sustainableharvest.com/blog/understanding-coffee-processing-the-traditional-methods"
      ]
    },
